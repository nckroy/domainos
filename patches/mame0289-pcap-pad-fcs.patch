+namespace {
+
+// Like taptun's finalise_frame(): pcap delivers frames as seen on the host,
+// without padding to the Ethernet minimum and without the frame check
+// sequence. Emulated controllers such as the i82586 check both, so pad to
+// 60 bytes and append the FCS, as the TAP backend does.
+constexpr int ETHERNET_MIN_FRAME = 64;
+constexpr int ETHERNET_MAX_FRAME = 1518;
+
+int finalise_frame(uint8_t *buf, int length)
+{
+	length = std::min(length, ETHERNET_MAX_FRAME - 4);
+	if (length < ETHERNET_MIN_FRAME - 4)
+	{
+		std::fill_n(&buf[length], ETHERNET_MIN_FRAME - 4 - length, 0);
+		length = ETHERNET_MIN_FRAME - 4;
+	}
+
+	const uint32_t fcs = util::crc32_creator::simple(buf, length);
+	buf[length++] = (fcs >> 0) & 0xff;
+	buf[length++] = (fcs >> 8) & 0xff;
+	buf[length++] = (fcs >> 16) & 0xff;
+	buf[length++] = (fcs >> 24) & 0xff;
+	return length;
+}
+
